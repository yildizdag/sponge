!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!! LINEAR BUCKLING ANALYSIS
!! BIOMIMETIC DESIGN BASED ON
!! EUPLECTELLA ASPERGILLUM
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
/PREP7
E = 1100
PR = 0.3
!!!!!!!!!!!!!!!!
!  PARAMETERS
!!!!!!!!!!!!!!!!
R = 11
H = 100
NV = 20
NC = 30
D_SHELIX = 1.3
AA = 0.15
BB = 0.15
LOOP_NO = 6
R1 = 0.3
R2 = 0.3
NUMBHELIX = 0
NUMBHELIX2 = 3
PITCH = H/LOOP_NO
PI = 3.1415927
DELTA_TH = 2*PI/NV
DELTA_H = H/(NC-1)
TH_SHELIX = D_SHELIX/R
NOBUCK = 1
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!  CROSS SECTION OF THE BIG HELIX
!!  AT THE END SECTION IS SAVED AND
!!  UNNECESSARY DATA IS DELETED
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
ET,1,PLANE82
CSYS,0
COUNT = 1
*DO,TH,0.0,180.0,180/12.0
K,COUNT,R1*COS(TH*PI/180),R2*SIN(TH*PI/180),0
COUNT = COUNT + 1
*ENDDO
FLST,3,13,3
SPLINE_COUNT = 1
*DO,I,1,13
FITEM,3,SPLINE_COUNT
SPLINE_COUNT = SPLINE_COUNT + 1
*ENDDO
BSPLIN,,P51X
CSYS,0
L,1,13
LESIZE,ALL, , ,40, ,1, , ,1,
AL,1,2
AMESH,ALL
ESEL,ALL
SECWRITE,big_helix
ACLEAR,ALL
ADELE,ALL,,,1